# CrewAI runtime (configure one or more; model order is committed in model_config.py)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
SERPER_API_KEY=your-serper-api-key


# Commit metadata generation: Gemini models are tried in order, then Groq
GEMINI_COMMIT_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_COMMIT_MODEL=openai/gpt-oss-120b
COMMIT_GENERATION_TIMEOUT=15
